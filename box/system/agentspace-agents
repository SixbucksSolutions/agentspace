# Markdown.
# ---------------------------------------------------------------------------------------------

def half_up(value, places):
    """A float to places decimals, a tie rounding up (away from zero), as text.

    The tie is judged on the decimal the arithmetic meant, not on the float's binary form: 21/200 is
    stored as 0.10499999999999993, which "%.2f" prints as 0.10. Rounding to 9 places first restores
    0.105, which then rounds up to 0.11.
    """
    exact = Decimal(repr(round(value, 9)))
    return str(exact.quantize(Decimal(10) ** -places, rounding=ROUND_HALF_UP, context=Context(prec=400)))


def fmt(value, integer=False):
    if value is None:
        return "-"
    if integer:
        return str(int(value))
    return half_up(value, 2)


def plural(count, word):
    return "%d %s%s" % (count, word, "" if count == 1 else "s")


def table(headers, rows):
    out = ["| " + " | ".join(headers) + " |", "|" + "|".join(" --- " for _ in headers) + "|"]
    for row in rows:
        out.append("| " + " | ".join(row) + " |")
    return out


def three(group):
    if group is None:
        return ["-", "-", "-"]
    return [fmt(group["peak"]), fmt(group["p95"]), fmt(group["p50"])]


def cell(text):
    return text.replace("|", "\\|")


def figure_table(result, view, key):
    head = ["Session"]
    for what, unit in (("CPU", "cores"), ("PSS", "MiB")):
        for stat in ("peak", "p95", "p50"):
            head.append("%s %s %s" % (what, unit, stat))
    rows = []
    for row, label in zip(result["sessions"], view["labels"]):
        group = row[key]
        cells = [cell(label)]
        cells += three(group["cpu_cores"] if group else None)
        cells += three(group["pss_mib"] if group else None)
        rows.append(cells)
    return table(head, rows)


def markdown(result, view):
    info = result["run"]
    tz = view["tz"]
    hosts = view["hosts"]
    out = ["# Agents of run %s" % info["run"], ""]
    if hosts:
        span = "%s to %s (%s)" % (clock(hosts[0][1], tz), clock(hosts[-1][1], tz), view["offset"])
    else:
        span = "No samples in the window (%s)" % view["offset"]
    out.append("- Span: %s" % span)
    out.append("- Samples: %d" % info["samples"])
    out.append("- Interval: %g %s" % (info["interval_s"], "second" if info["interval_s"] == 1 else "seconds"))
    out.append("- CPUs: %d" % info["cpus"])
    cores = info["sampler_cores"]
    if cores is None:
        out.append("- Sampler overhead: -")
    else:
        out.append("- Sampler overhead: %s cores (%s%% of one core)"
                   % (half_up(cores, 4), half_up(cores * 100, 2)))
    out.append("- Transcripts read: %d" % view["transcripts"])
    out.append("")

    out.append("## Host")
    out.append("")
    host = result["host"]
    head = ["CPU cores peak", "CPU cores p95", "CPU cores p50",
            "Memory GiB peak", "Memory GiB p95", "Memory GiB p50",
            "Sessions peak", "Subagents peak", "Subagents peak at"]
    peak_at = clock(view["peak_when"], tz) if view["peak_when"] is not None else "-"
    out += table(head, [three(host["cpu_cores"]) + three(host["mem_gib"])
                        + [str(host["sessions_peak"]), fmt(host["subagents_peak"], integer=True), peak_at]])
    out.append("")

    out.append("## Sessions")
    out.append("")
    if not result["sessions"]:
        out.append("No sessions.")
        out.append("")
    else:
        head = ["Session", "Seen", "Transcript", "Subagents", "Subagents peak",
                "Intervals with subagents", "Intervals main alone"]
        rows = []
        for row, label, (t0, t1) in zip(result["sessions"], view["labels"], view["times"]):
            counts = row["intervals"]
            name = row["transcript"]
            if name is None:
                shown = "Not joined"
            elif name in view["missing"]:
                shown = cell(name) + " (missing; its subagents only)"
            else:
                shown = cell(name)
            rows.append([
                cell(label),
                "%s to %s" % (clock(t0, tz), clock(t1, tz)),
                shown,
                fmt(row["subagents"], integer=True),
                fmt(row["subagents_peak"], integer=True),
                fmt(counts["with_subagents"] if counts else None, integer=True),
                fmt(counts["main_alone"] if counts else None, integer=True),
            ])
        out += table(head, rows)
        out.append("")

        out.append("### Self")
        out.append("")
        out.append("The session's own process.")
        out.append("")
        out += figure_table(result, view, "self")
        out.append("")

        out.append("### Per working agent")
        out.append("")
        out.append("Each figure is %s." % DIVISOR)
        out.append("")
        out += figure_table(result, view, "per_agent")
        out.append("")

        out.append("### Main agent alone")
        out.append("")
        out.append("The session's tool calls, undivided, over the intervals and at the samples when "
                   "none of its subagents was running.")
        out.append("")
        out += figure_table(result, view, "main_alone")
        out.append("")

    out.append("## Notes")
    out.append("")
    notes = result["notes"]
    lines = []
    if notes["skipped_lines"]:
        lines.append("Skipped %s." % plural(notes["skipped_lines"], "malformed line"))
    if notes["clamped"]:
        lines.append("Clamped %s to 0." % plural(notes["clamped"], "negative difference"))
    if notes["gaps"]:
        lines.append("Left out %s of more than three times the interval from the CPU figures."
                     % plural(notes["gaps"], "gap"))
    if notes["missing_end"]:
        lines.append("No end line: the record was summarized up to its last complete line.")
    if notes["sessions_unjoined"]:
        lines.append("Joined to no transcript, so given self figures only: %s."
                     % ", ".join(notes["sessions_unjoined"]))
    reasons = {"roots": "more matching checkout roots", "overlap": "more overlap",
               "name": "the smaller file name"}
    for tie in notes["join_ties"]:
        lines.append("A tie within 1 second decided session %s: joined to %s over %s, by %s."
                     % (tie["session"], tie["transcript"], ", ".join(tie["tied_with"]),
                        reasons[tie["decided_by"]]))
    if notes["transcripts_unread"]:
        lines.append("Could not read, or found no time in, %s: %s."
                     % (plural(len(notes["transcripts_unread"]), "transcript"),
                        ", ".join(notes["transcripts_unread"])))
    if notes["transcripts_unjoined"]:
        lines.append("Joined to no session: %s: %s."
                     % (plural(len(notes["transcripts_unjoined"]), "transcript"),
                        ", ".join(notes["transcripts_unjoined"])))
    if notes["subagents_unread"]:
        lines.append("Could not read, or found no time in, %s: %s."
                     % (plural(len(notes["subagents_unread"]), "subagent transcript"),
                        ", ".join(notes["subagents_unread"])))
    if notes["subagents_parent_missing"]:
        lines.append("Main transcript missing or unreadable, so read alone and joined by their own "
                     "lines' sessionId and cwd: %s: %s."
                     % (plural(len(notes["subagents_parent_missing"]), "subagent transcript"),
                        ", ".join(notes["subagents_parent_missing"])))
    if notes["subagents_resumed"]:
        lines.append("Resumed, with more than one completion notice in the main transcript, so "
                     "the span may include idle time: %s: %s."
                     % (plural(len(notes["subagents_resumed"]), "subagent"),
                        ", ".join(notes["subagents_resumed"])))
    if notes["transcript_lines_malformed"]:
        lines.append("Skipped %s in the transcripts."
                     % plural(notes["transcript_lines_malformed"], "malformed line"))
    if notes["transcript_lines_untimed"]:
        lines.append("Passed over %s with no timestamp in the transcripts, for time only."
                     % plural(notes["transcript_lines_untimed"], "line"))
    if notes["subagents_outside"]:
        lines.append("Left out %s of a joined transcript that ran outside its session's samples."
                     % plural(notes["subagents_outside"], "subagent"))
    out += ["- " + text for text in lines] if lines else ["None."]
    return "\n".join(out) + "\n"


def main(argv):
    extra = {"color": False} if sys.version_info >= (3, 14) else {}
    parser = Parser(
        prog=PROG,
        usage="%(prog)s <record.jsonl> <transcripts folder> [--from <ISO 8601>] [--to <ISO 8601>] [--json]",
        description="Divide each session's tool calls among its working agents, from an "
                    "agentspace-sample record and the sessions' transcripts.",
        formatter_class=Formatter,
        add_help=False,
        **extra,
    )
    arguments = parser.add_argument_group("Arguments")
    options = parser.add_argument_group("Options")
    arguments.add_argument("record", help="The record, ~/agentspace-samples/<run>.jsonl")
    arguments.add_argument("transcripts", help="The folder holding the sessions' transcripts, such as ~/.claude/projects")
    options.add_argument("--from", dest="start", metavar="ISO8601",
                         help="Keep only samples at or after this time (with a UTC offset)")
    options.add_argument("--to", dest="end", metavar="ISO8601",
                         help="Keep only samples at or before this time (with a UTC offset)")
    options.add_argument("--json", action="store_true",
                         help="Print one JSON object instead of Markdown")
    options.add_argument("-h", "--help", action="help", help="Show this help and exit")
    args = parser.parse_args(argv)

    window = []
    for flag, text in (("--from", args.start), ("--to", args.end)):
        if text is None:
            window.append(None)
            continue
        value = parse_time(text)
        if value is None:
            die("%s needs an ISO 8601 time with a UTC offset, such as 2026-11-18T01:45:00-08:00; got %r"
                % (flag, text))
        window.append(value)
    if window[0] is not None and window[1] is not None and window[0] > window[1]:
        die("--from is after --to")
    if not os.path.isdir(args.transcripts):
        die("cannot read %s: not a folder" % args.transcripts)

    lines, skipped = read_record(args.record)
    transcripts, read_notes = read_spans(args.transcripts)
    result, view = summarize(lines, skipped, window[0], window[1], transcripts, read_notes)
    try:
        sys.stdout.reconfigure(encoding="utf-8", newline="\n")
    except (AttributeError, ValueError):
        pass
    if args.json:
        sys.stdout.write(json.dumps(result, indent=2) + "\n")
    else:
        sys.stdout.write(markdown(result, view))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
