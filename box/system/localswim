#!/bin/bash
# Runs the localswim CLI as Bot against Terry's board. The board runs on his laptop, and the
# agentspace SSH entry forwards it to this box's loopback only while he is connected. The URL and
# Bot token come from ~/.config/localswim/bot.env, which agentspace.ps1 writes when he connects
# and the token has changed; they are set for this one run and never printed.
set -euo pipefail
bin=/usr/local/lib/localswim/localswim
env_file="${HOME}/.config/localswim/bot.env"

if [ ! -x "$bin" ]; then
  echo "localswim: The CLI is not installed; run 'agentspace.ps1 sync' on the laptop." >&2
  exit 1
fi
if [ ! -r "$env_file" ]; then
  echo "localswim: No Bot credentials yet; they arrive when Terry connects with 'ssh agentspace'." >&2
  exit 1
fi

set -a
. "$env_file"
set +a

hostport="${LOCALSWIM_URL#http://}"
hostport="${hostport%%/*}"
if ! (exec 3<>"/dev/tcp/${hostport%:*}/${hostport##*:}") 2>/dev/null; then
  echo "localswim: The board at $LOCALSWIM_URL is unreachable. It is forwarded from Terry's laptop only while he is connected over SSH. Stop and report; do not work without a card." >&2
  exit 1
fi

exec "$bin" "$@"
