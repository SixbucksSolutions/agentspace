{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SixbucksSolutions/agentspace/schemas/v2/lease-list.output.schema.json",
  "title": "Lease list (output, contract v2)",
  "description": "The leases that agentspace lease list prints, oldest first. Each item is a lease exactly as in lease.output.schema.json, whose $defs this file copies word for word, because Test-Json -SchemaFile does not resolve a $ref to another file. Strict: anchored patterns end with $(?!\\n), since $ alone matches before a final line feed in .NET. See docs/lease-api.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["leases"],
  "properties": {
    "leases": {
      "type": "array",
      "items": { "$ref": "#/$defs/lease" }
    }
  },
  "$defs": {
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project", "state", "platform", "profile", "size", "ttl_seconds", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/lease_id" },
        "project": { "$ref": "#/$defs/project" },
        "state": { "$ref": "#/$defs/state" },
        "platform": { "$ref": "#/$defs/platform" },
        "profile": { "$ref": "#/$defs/profile" },
        "size": { "$ref": "#/$defs/size" },
        "ttl_seconds": { "$ref": "#/$defs/ttl_seconds" },
        "created_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" },
        "released_at": { "$ref": "#/$defs/time" },
        "ssh": { "$ref": "#/$defs/ssh" },
        "reasons": {
          "description": "Every reason that applies, each code at most once, in the order unsupported_platform, unsupported_profile, unsupported_size, plan_too_large, no_capacity. plan_too_large is always the only reason. The order is not checked here.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/reason" },
          "allOf": [
            { "contains": { "properties": { "code": { "const": "unsupported_platform" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "unsupported_profile" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "unsupported_size" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "plan_too_large" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "no_capacity" } } }, "minContains": 0, "maxContains": 1 }
          ]
        },
        "sized_for": { "$ref": "#/$defs/sized_for" }
      },
      "allOf": [
        {
          "if": { "required": ["reasons"], "properties": { "reasons": { "contains": { "required": ["code"], "properties": { "code": { "const": "plan_too_large" } } } } } },
          "then": { "required": ["state", "size", "sized_for"], "properties": { "state": { "const": "unsatisfiable" }, "size": { "const": "xl" }, "reasons": { "maxItems": 1 } } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "pending" } } },
          "then": { "properties": { "expires_at": false, "released_at": false, "ssh": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "ready" } } },
          "then": { "required": ["expires_at", "ssh"], "properties": { "released_at": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "expired" } } },
          "then": { "required": ["expires_at"], "properties": { "released_at": false, "ssh": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "released" } } },
          "then": { "required": ["released_at"], "properties": { "ssh": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "unsatisfiable" } } },
          "then": { "required": ["reasons"], "properties": { "expires_at": false, "released_at": false, "ssh": false } }
        }
      ]
    },
    "lease_id": {
      "description": "A UUIDv4 in lowercase.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?!\\n)"
    },
    "project": {
      "description": "A project name, lowercase.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$(?!\\n)"
    },
    "state": {
      "type": "string",
      "enum": ["pending", "ready", "expired", "released", "unsatisfiable"]
    },
    "platform": {
      "description": "An OCI os/arch[/variant], lowercase, with aarch64 written arm64 and the arm64 variant v8 dropped.",
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9]+(/[a-z0-9]+)?$(?!\\n)",
      "not": { "pattern": "^[a-z0-9]+/(aarch64(/[a-z0-9]+)?|arm64/v8)$(?!\\n)" }
    },
    "profile": {
      "description": "A profile name, lowercase, with an optional @version that has no leading zeros.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?(@[1-9][0-9]*)?$(?!\\n)"
    },
    "size": {
      "description": "A size class, lowercase.",
      "type": "string",
      "pattern": "^[a-z0-9]{1,8}$(?!\\n)"
    },
    "ttl_seconds": {
      "description": "A TTL in whole seconds, from 1 minute to 24 hours (D24).",
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "time": {
      "description": "A UTC time to the whole second, YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?!\\n)"
    },
    "ssh": {
      "description": "How to connect to a ready lease.",
      "type": "object",
      "additionalProperties": false,
      "required": ["host_alias", "user"],
      "properties": {
        "host_alias": {
          "description": "The OpenSSH host alias, agentspace-<project>-<first 8 hex digits of the lease ID>. Callers treat it as opaque.",
          "type": "string",
          "pattern": "^agentspace-[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?-[0-9a-f]{8}$(?!\\n)"
        },
        "user": {
          "description": "The user the alias logs in as: 1 to 64 letters, digits, '.', '_' and '-', not starting with '.' or '-'. Not limited to Unix user names, so that a Windows host needs no new contract version.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}$(?!\\n)"
        }
      }
    },
    "reason": {
      "description": "Why an unsatisfiable lease cannot be met.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["unsupported_platform", "unsupported_profile", "unsupported_size", "plan_too_large", "no_capacity"]
        },
        "message": {
          "description": "One sentence for a person, with no control characters, not starting with a space.",
          "type": "string",
          "pattern": "^[^\\u0000-\\u0020\\u007f][^\\u0000-\\u001f\\u007f]*$(?!\\n)"
        }
      }
    },
    "sized_for": {
      "description": "What a lease created with a plan was sized for: the plan's name when it has one, its busiest turn's name, and that turn's agents at once, its dev lead counted. Present on every lease created with a plan, in every state, and on no other lease.",
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "agents"],
      "properties": {
        "plan": { "$ref": "#/$defs/plan_name" },
        "turn": { "$ref": "#/$defs/plan_name" },
        "agents": {
          "description": "The busiest turn's agents at once: the sum of its stories' peaks, plus 1 for its dev lead. At least 2, a story of one subagent and the dev lead, and at most 1025, the most a plan's bounds allow: 32 stories of 32 subagents each, and the dev lead.",
          "type": "integer",
          "minimum": 2,
          "maximum": 1025
        }
      }
    },
    "plan_name": {
      "description": "A name in a plan, as given: 1 to 64 printable ASCII characters, not starting or ending with a space. Never trimmed or case-folded.",
      "type": "string",
      "pattern": "^[!-~]([ -~]{0,62}[!-~])?$(?!\\n)"
    }
  }
}
