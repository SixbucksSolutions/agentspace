#!/bin/bash
# Powers the box off after IDLE_MINUTES with no SSH or Session Manager session
# and no CPU work. The instance's shutdown behavior is "stop" (D11).
#
# It also powers the box off once the lease horizon plus HORIZON_GRACE_MINUTES
# has passed, at the first check with no SSH or Session Manager session and no
# patch run, whatever the CPU is doing (D57; a patch run holds it off as a
# session does: architect, 2026-11-21, for v0.08-T01). The horizon is in
# <state>/lease-horizon, which the guard writes; a box without a valid one
# keeps D11's rule alone.
#
# A Session Manager session counts only while its worker holds an established
# connection to this host's sshd, or runs a shell of its own (D78): a worker
# whose sshd end is gone, as sshd drops a dead client, is not a session.
#
# AGENTSPACE_IDLE_STATE, AGENTSPACE_IDLE_CONF and AGENTSPACE_PROC_STAT are the
# only test-only variables; they are for box/tests alone (D63), and unset or
# empty, they name the box's own files. The tests put stand-ins for the
# programs this starts (ss, pgrep, systemctl and the rest) first on PATH.
set -euo pipefail
IDLE_MINUTES=60
BUSY_CPU_SECONDS=6
HORIZON_GRACE_MINUTES=15
conf=${AGENTSPACE_IDLE_CONF:-/etc/agentspace/idle.conf}
state=${AGENTSPACE_IDLE_STATE:-/run/agentspace}
proc_stat=${AGENTSPACE_PROC_STAT:-/proc/stat}
# shellcheck source=/dev/null
[ -r "$conf" ] && . "$conf"
mkdir -p "$state"
now=$(date +%s)
# /run is cleared at boot, so every boot starts a fresh idle window.
[ -f "$state/last-active" ] || echo "$now" > "$state/last-active"

# Busy CPU ticks across the whole box (user+nice+system+irq+softirq+steal).
busy=$(awk '/^cpu /{print $2+$3+$4+$7+$8+$9}' "$proc_stat")
prev=$(cat "$state/busy" 2>/dev/null || echo "$busy")
echo "$busy" > "$state/busy"
cpu_s=$(( (busy - prev) / $(getconf CLK_TCK) ))

# A session is an SSH or Session Manager session. Only a session or a patch run
# holds the box past its horizon (architect, 2026-11-21, for v0.08-T01).
# A Session Manager worker counts (D78) when ss lists it, by its PID, as the
# owner of an established connection to port 22, or when it has a child: a
# shell session's worker runs a shell, and a port session's has none.
session=""
if [ "$(ss -Htn state established '( sport = :22 )' | wc -l)" -gt 0 ]; then
  session="SSH session open"
else
  workers=$(pgrep -f ssm-session-worker || true)
  if [ -n "$workers" ]; then
    to_sshd=$(ss -Htnp state established '( dport = :22 )' || true)
    for worker in $workers; do
      [[ "$worker" =~ ^[0-9]+$ ]] || continue
      if [[ "$to_sshd" == *"pid=$worker,"* ]] || [ -n "$(pgrep -P "$worker" || true)" ]; then
        session="Session Manager session open"
        break
      fi
    done
  fi
fi
patch=""
if [ -z "$session" ] && systemctl is-active --quiet agentspace-patch.service; then
  patch="Patching"
fi

# The horizon: one line of Unix seconds. Missing, unreadable, empty or not a
# non-negative integer (1 to 15 digits), it is ignored without a word.
if [ -z "$session" ] && [ -z "$patch" ]; then
  horizon=$(head -n 1 "$state/lease-horizon" 2>/dev/null || true)
  if [[ "$horizon" =~ ^[0-9]{1,15}$ ]]; then
    grace=$HORIZON_GRACE_MINUTES
    if ! [[ "$grace" =~ ^[0-9]{1,6}$ ]]; then
      echo "Invalid HORIZON_GRACE_MINUTES in $conf; using 15" >&2
      grace=15
    fi
    grace=$((10#$grace))
    if [ "$now" -ge $(( 10#$horizon + grace * 60 )) ]; then
      h_time=$(date -d "@$((10#$horizon))" +%-I:%M%P) || h_time="@$horizon"
      echo "Past lease horizon $h_time plus $grace min with no session; powering off"
      systemctl poweroff
      exit 0
    fi
  fi
fi

reason="$session"
if [ -n "$reason" ]; then
  :
elif [ -n "$patch" ]; then
  reason="$patch"
elif [ "$cpu_s" -ge "$BUSY_CPU_SECONDS" ]; then
  reason="CPU work: $cpu_s s since last check"
fi

if [ -n "$reason" ]; then
  echo "$now" > "$state/last-active"
  echo "Active: $reason"
  exit 0
fi

idle_min=$(( (now - $(cat "$state/last-active")) / 60 ))
if [ "$idle_min" -ge "$IDLE_MINUTES" ]; then
  echo "Idle for $idle_min min (limit $IDLE_MINUTES); powering off"
  systemctl poweroff
else
  echo "Idle for $idle_min min of $IDLE_MINUTES (CPU $cpu_s s since last check)"
fi
