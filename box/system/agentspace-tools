#!/bin/bash
# Keeps the ubuntu user's toolchain current. Run at every boot by agentspace-patch:
#   - Node: the newest LTS becomes fnm's default (npm is the one it ships with)
#   - Codex: latest, reinstalled under that Node
#   - uv: latest
# Claude Code updates itself; gh is patched by apt.
set -uo pipefail
export PATH="$HOME/.local/share/fnm:$HOME/.local/bin:$PATH"
if ! command -v fnm >/dev/null; then
  echo "Tools: fnm is not installed yet; run box/bootstrap.sh"
  exit 0
fi
eval "$(fnm env --shell bash)"

lts=$(fnm ls-remote --lts | awk '{print $1}' | tail -1)
if [ -z "$lts" ]; then
  echo "Tools: could not read the Node LTS list; keeping $(fnm current)"
else
  fnm install "$lts" >/dev/null
  fnm default "$lts"
  fnm use default >/dev/null
  # Drop older releases of the same major to keep the disk small.
  major=${lts%%.*}
  for v in $(fnm ls | grep -oE "${major}\.[0-9]+\.[0-9]+" | sort -u); do
    [ "$v" = "$lts" ] || fnm uninstall "$v" >/dev/null 2>&1 || true
  done
fi

npm install -g @openai/codex@latest --no-fund --no-audit --loglevel=error
npm cache clean --force >/dev/null 2>&1 || true
uv self update -q 2>/dev/null || true

echo "Tools: Node $(node --version), npm $(npm --version), $(codex --version), $(uv --version)"
