{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SixbucksSolutions/agentspace/schemas/state/v0/leases.state.schema.json",
  "title": "Lease state file (laptop, internal)",
  "description": "The lease CLI's state file, %USERPROFILE%\\.agentspace\\leases.json (D8, D21). Internal: it is not part of the lease contract, and no caller reads it. One record per lease, holding the lease document's fields with its state as stored (pending, ready, released or unsatisfiable; expired is derived when the record is read, never stored), plus the opaque name of the driver that placed it, which never reaches any output. Strict like the contract's output schemas: anchored patterns end with $(?!\\n). Every member it shares with the lease document has lease.output.schema.json's pattern, except ssh.user, which is narrower. A file in which two records share an id is not valid, though this schema cannot refuse it. See docs/state.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "leases"],
  "properties": {
    "version": { "const": 0 },
    "leases": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project", "state", "platform", "profile", "size", "ttl_seconds", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/lease_id" },
        "project": { "$ref": "#/$defs/project" },
        "state": { "type": "string", "enum": ["pending", "ready", "released", "unsatisfiable"] },
        "platform": { "$ref": "#/$defs/platform" },
        "profile": { "$ref": "#/$defs/profile" },
        "size": { "$ref": "#/$defs/size" },
        "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "created_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" },
        "released_at": { "$ref": "#/$defs/time" },
        "ssh": { "$ref": "#/$defs/ssh" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/reason" },
          "allOf": [
            { "contains": { "properties": { "code": { "const": "unsupported_platform" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "unsupported_profile" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "unsupported_size" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "properties": { "code": { "const": "no_capacity" } } }, "minContains": 0, "maxContains": 1 }
          ]
        },
        "driver": {
          "description": "The opaque name of the driver that placed the lease, handed back to it on renew and release.",
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?!\\n)"
        }
      },
      "allOf": [
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "pending" } } },
          "then": { "properties": { "expires_at": false, "released_at": false, "ssh": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "ready" } } },
          "then": { "required": ["expires_at", "ssh"], "properties": { "released_at": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "released" } } },
          "then": { "required": ["released_at"], "properties": { "ssh": false, "reasons": false } }
        },
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "unsatisfiable" } } },
          "then": { "required": ["reasons"], "properties": { "expires_at": false, "released_at": false, "ssh": false } }
        }
      ]
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?!\\n)"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$(?!\\n)"
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9]+(/[a-z0-9]+)?$(?!\\n)",
      "not": { "pattern": "^[a-z0-9]+/(aarch64(/[a-z0-9]+)?|arm64/v8)$(?!\\n)" }
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?(@[1-9][0-9]*)?$(?!\\n)"
    },
    "size": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,8}$(?!\\n)"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?!\\n)"
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_alias", "user"],
      "properties": {
        "host_alias": {
          "type": "string",
          "pattern": "^agentspace-[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?-[0-9a-f]{8}$(?!\\n)"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$(?!\\n)"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["unsupported_platform", "unsupported_profile", "unsupported_size", "no_capacity"]
        },
        "message": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u0020\\u007f][^\\u0000-\\u001f\\u007f]*$(?!\\n)"
        }
      }
    }
  }
}
